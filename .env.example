# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/e-commerce"

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
ACCESS_TOKEN_SECRET=your_64_char_random_secret_here
REFRESH_TOKEN_SECRET=your_other_64_char_random_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail (OTP + jobs) — App Password, 16 characters, no spaces
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=abcdefghijklmnop

# Public origin for reset links (no trailing slash)
BASE_URL=http://localhost:3000

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (cart, rate limit, Bull). Local default; Upstash uses rediss://...
REDIS_URL=redis://127.0.0.1:6379

# Email worker: true = run inside the API (Render free / npm run dev / Docker).
# false = API only; start mail with npm run worker.
RUN_WORKER_IN_PROCESS=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
