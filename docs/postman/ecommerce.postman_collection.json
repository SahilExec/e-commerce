{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ecommerce0001",
    "name": "E-Commerce Backend",
    "description": "Collection for the Express e-commerce API.\n\n**Setup**\n1. Set `{{baseUrl}}` (local default `http://localhost:3000`, or your deployed origin).\n2. Register, verify OTP, then **Login**. The login test stores `{{accessToken}}`.\n3. Postman sends the `refreshToken` httpOnly cookie automatically after login (cookie jar).\n4. Admin product/category routes need a user with role `ADMIN`.\n\n**Auth**\n- Access token: `Authorization: Bearer {{accessToken}}`\n- Refresh: `POST /auth/refresh-token` uses the cookie only (no Bearer header).\n- Logout needs both Bearer and the cookie.\n\nDo not paste secrets, Razorpay keys, or real card numbers into this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "productSlug", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "categorySlug", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "razorpayOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Process is up', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.message).to.eql('Server is running');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness JSON. No auth."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created or email already registered', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('User payload, no password', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.have.property('email');",
                  "    pm.expect(json.data).to.not.have.property('password');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sahil\",\n  \"email\": \"you@example.com\",\n  \"password\": \"password12\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a CUSTOMER. Password min 8. OTP email is attempted. 409 if email exists."
          }
        },
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Always 200 when body is valid', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/send-otp",
            "description": "Rate limited (3 / 15 min per IP and email). Unknown emails still return 200."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 400', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp",
            "description": "OTP must be 6 digits. Rate limited (5 / 15 min)."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns accessToken and sets refresh cookie', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"password12\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Returns `{ data: { accessToken } }` and sets httpOnly cookie `refreshToken` (7 days, SameSite=strict). Unverified users get 403. Test saves `{{accessToken}}`."
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires Bearer access token."
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rotated access token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh-token",
            "description": "No Bearer header. Sends the `refreshToken` cookie. Rotates the cookie and returns a new access token."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('accessToken', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Requires Bearer access token AND the refresh cookie. Blacklists the access token, deletes the refresh row, clears the cookie."
          }
        },
        {
          "name": "Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Enumeration-safe 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.message).to.eql('If that email exists, we sent a reset token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Always 200 if the body is valid. Unknown emails do not enqueue mail. Rate limited (3 / 15 min)."
          }
        },
        {
          "name": "Reset password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 400', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newpass12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password?token=PASTE_TOKEN_FROM_EMAIL",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_TOKEN_FROM_EMAIL",
                  "description": "Hex token from the reset email. Can also be sent in the JSON body."
                }
              ]
            },
            "description": "Token from query or JSON body; password always in the body (min 8). Rate limited (5 / 15 min per IP)."
          }
        }
      ]
    },
